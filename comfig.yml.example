# Copy this file to config.yml and fill in your API keys locally.
stages:
  prod:
    cognition:
      openai:
        base_url: https://api.deepseek.com
        api_key: YOUR_DEEPSEEK_API_KEY
        organization: MSTE
        default_model: deepseek-flash
        model_provider: deepseek
        extra_body:
          thinking:
            type: enabled
          reasoning_effort: low
        temperature: 0
        timeout_seconds: 600
        models:
          deepseek-flash:
            max_tokens: 128000
    search:
      backend: tavily
      tavily:
        api_key: YOUR_TAVILY_API_KEY
        base_url: https://api.tavily.com
        max_results: 3
        topic: general
        include_raw_content: true
        timeout_seconds: 300
    roles:
      supervisor:
        backend: openai
        handle: deepseek-flash 
        max_tokens: 128000
        timeout_seconds: 600
      red_team:
        backend: openai
        handle: deepseek-flash 
        max_tokens: 128000
        timeout_seconds: 600
      context_pruner:
        backend: openai
        handle: deepseek-flash 
        max_tokens: 128000
        timeout_seconds: 600
      researcher_main:
        backend: openai
        handle: deepseek-flash
        max_tokens: 128000
        timeout_seconds: 600
      researcher_summarizer:
        backend: openai
        handle: deepseek-flash
        max_tokens: 128000
        timeout_seconds: 600
      researcher_compressor:
        backend: openai
        handle: deepseek-flash
        max_tokens: 128000
        timeout_seconds: 600
      writer:
        backend: openai
        handle: deepseek-flash
        max_tokens: 128000
        timeout_seconds: 600
      draft:
        backend: openai
        handle: deepseek-flash 
        max_tokens: 128000
        timeout_seconds: 600
      evaluator:
        backend: openai
        handle: deepseek-flash 
        max_tokens: 128000
        timeout_seconds: 600
